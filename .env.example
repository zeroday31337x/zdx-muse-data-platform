# Server-side only. Verify exact Meta endpoint/models and account access before enabling inference.
MODEL_API_KEY=
META_API_BASE_URL=
DATABASE_URL=
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
# Phase 2
AUTH_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
META_DAILY_SPEND_LIMIT_USD=20
META_TOTAL_SPEND_LIMIT_USD=170
STRICT_TOKEN_GATE=false
# Cognito (names only — real values are server-side only, never in git)
COGNITO_REGION=
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_ISSUER=
COGNITO_DOMAIN=
COGNITO_REDIRECT_URI=
COGNITO_ADMIN_GROUP=zdx-data-admin
# Stripe (TEST MODE ONLY in this phase; production charging disabled)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
# STRIPE_PRICE_PROFESSIONAL is DEFERRED per the pricing hold (finish
# platform → cost runs → set prices from measured costs → then create
# products). Leave empty until then. The old STRIPE_PRICE_BASIC entry was
# removed: 'basic' is a scratched, unmapped plan key and must never be
# configured as a live price.
STRIPE_PRICE_PROFESSIONAL=
STRIPE_MODE=test
APP_URL=
# Hard infrastructure spending ceiling (env/code only, never dashboard
# adjustable; value must be set explicitly before staging — see docs)
HARD_META_DAILY_CAP_USD=
HARD_META_TOTAL_CAP_USD=
HARD_META_PER_JOB_CAP_USD=
# First-operator bootstrap token (server env only, never in git/chat).
# Required ONLY when no PlatformOperator row exists yet; afterwards
# operator creation requires a full-MFA operator session.
OPERATOR_BOOTSTRAP_TOKEN=
